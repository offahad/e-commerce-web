{
  "info": {
    "name": "Liton Brothers E-Commerce API Collection",
    "description": "Comprehensive Postman Collection for Liton Brothers API testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:4000/api/v1",
      "type": "string"
    },
    {
      "key": "ACCESS_TOKEN",
      "value": "",
      "type": "string"
    },
    {
      "key": "REFRESH_TOKEN",
      "value": "",
      "type": "string"
    },
    {
      "key": "ADMIN_ACCESS_TOKEN",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Customer Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rahim Uddin\",\n  \"phone\": \"01712345678\",\n  \"password\": \"Customer@123\",\n  \"confirmPassword\": \"Customer@123\",\n  \"address\": \"House 12, Road 4, Sector 7, Uttara, Dhaka\",\n  \"email\": \"rahim@example.com\"\n}"
            },
            "url": "{{BASE_URL}}/auth/register"
          }
        },
        {
          "name": "Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('ACCESS_TOKEN', json.data.accessToken);",
                  "  pm.collectionVariables.set('REFRESH_TOKEN', json.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01712345678\",\n  \"password\": \"Customer@123\",\n  \"rememberMe\": true\n}"
            },
            "url": "{{BASE_URL}}/auth/login"
          }
        },
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('ADMIN_ACCESS_TOKEN', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01700000000\",\n  \"password\": \"Admin@123456\"\n}"
            },
            "url": "{{BASE_URL}}/auth/login"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{REFRESH_TOKEN}}\"\n}"
            },
            "url": "{{BASE_URL}}/auth/refresh"
          }
        },
        {
          "name": "Current User Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Customer",
      "item": [
        {
          "name": "Check Shopping Approval Eligibility",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/customers/shopping-check"
          }
        },
        {
          "name": "List Addresses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/customers/addresses"
          }
        },
        {
          "name": "Add Address",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rahim Uddin (Office)\",\n  \"phone\": \"01712345678\",\n  \"address\": \"Floor 4, Plot 10, Gulshan 1, Dhaka\",\n  \"division\": \"Dhaka\",\n  \"district\": \"Dhaka\",\n  \"addressType\": \"OFFICE\",\n  \"isDefault\": false\n}"
            },
            "url": "{{BASE_URL}}/customers/addresses"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List Pending Customers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/admin/customers?status=PENDING_APPROVAL"
          }
        },
        {
          "name": "Approve Customer Account",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ADMIN_ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\",\n  \"reason\": \"Customer phone and delivery address verified.\"\n}"
            },
            "url": "{{BASE_URL}}/admin/customers/:id/status"
          }
        },
        {
          "name": "View Audit Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/admin/audit-logs"
          }
        },
        {
          "name": "List Roles & Permissions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ADMIN_ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/admin/roles"
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Get Category Tree",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/categories"
          }
        },
        {
          "name": "Get Active Brands",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/brands"
          }
        },
        {
          "name": "Search & Filter Products",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/products?q=Oil&sortBy=price_asc"
          }
        },
        {
          "name": "Product Suggestions Autocomplete",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/products/suggestions?q=Rice"
          }
        },
        {
          "name": "Product Details with Variants",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/products/teer-pure-soybean-oil"
          }
        }
      ]
    },
    {
      "name": "Cart & Wishlist",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/cart"
          }
        },
        {
          "name": "Add Item to Cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variantId\": \"{{VARIANT_ID}}\",\n  \"quantity\": 2\n}"
            },
            "url": "{{BASE_URL}}/cart/items"
          }
        },
        {
          "name": "Update Cart Item Quantity",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}"
            },
            "url": "{{BASE_URL}}/cart/items/:id"
          }
        },
        {
          "name": "Remove Item from Cart",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/cart/items/:id"
          }
        },
        {
          "name": "Get Customer Wishlist",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/wishlist"
          }
        },
        {
          "name": "Toggle Wishlist Item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/wishlist/:productId"
          }
        }
      ]
    },
    {
      "name": "Deals & Coupons",
      "item": [
        {
          "name": "Active Friday Flash Deal",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/deals/friday-flash"
          }
        },
        {
          "name": "Deals of the Day",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/deals/deals-of-the-day"
          }
        },
        {
          "name": "Validate Coupon Code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"RAMADAN20\",\n  \"subtotal\": 850,\n  \"deliveryFee\": 60\n}"
            },
            "url": "{{BASE_URL}}/coupons/validate"
          }
        }
      ]
    },
    {
      "name": "Checkout",
      "item": [
        {
          "name": "Server-Side Checkout Preview",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"couponCode\": \"RAMADAN20\",\n  \"items\": [\n    {\n      \"variantId\": \"{{VARIANT_ID}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": "{{BASE_URL}}/checkout/preview"
          }
        }
      ]
    },
    {
      "name": "Settings",
      "item": [
        {
          "name": "Get Public Business Settings",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/settings"
          }
        }
      ]
    },
    {
      "name": "Orders & Payments",
      "item": [
        {
          "name": "Place Order (Cash on Delivery)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"variantId\": \"{{VARIANT_ID}}\",\n      \"quantity\": 2\n    }\n  ],\n  \"paymentMethod\": \"COD\",\n  \"couponCode\": \"RAMADAN20\",\n  \"deliverySlot\": \"Evening Slot (6 PM - 9 PM)\",\n  \"customerNotes\": \"Please call before arriving.\"\n}"
            },
            "url": "{{BASE_URL}}/orders"
          }
        },
        {
          "name": "Place Order (bKash Gateway)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"variantId\": \"{{VARIANT_ID}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"paymentMethod\": \"BKASH\",\n  \"deliverySlot\": \"Standard Delivery (9 AM - 6 PM)\"\n}"
            },
            "url": "{{BASE_URL}}/orders"
          }
        },
        {
          "name": "Customer Order History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "url": "{{BASE_URL}}/orders?page=1&limit=10"
          }
        },
        {
          "name": "Order Detail by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "url": "{{BASE_URL}}/orders/{{ORDER_ID}}"
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Changed mind on variant size\"\n}"
            },
            "url": "{{BASE_URL}}/orders/{{ORDER_ID}}/cancel"
          }
        },
        {
          "name": "Public Real-Time Order Tracking Timeline",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/orders/track/{{TRACKING_NUMBER}}"
          }
        }
      ]
    },
    {
      "name": "Admin Orders",
      "item": [
        {
          "name": "Admin List All Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ADMIN_ACCESS_TOKEN}}" }
            ],
            "url": "{{BASE_URL}}/admin/orders?page=1&limit=20&status=PENDING"
          }
        },
        {
          "name": "Admin Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ADMIN_ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\",\n  \"comment\": \"Order verified by warehouse team\"\n}"
            },
            "url": "{{BASE_URL}}/admin/orders/{{ORDER_ID}}/status"
          }
        },
        {
          "name": "Admin Update Payment Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ADMIN_ACCESS_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentStatus\": \"PAID\",\n  \"transactionId\": \"TRX-MANUAL-98234\",\n  \"comment\": \"Verified bank deposit\"\n}"
            },
            "url": "{{BASE_URL}}/admin/orders/{{ORDER_ID}}/payment"
          }
        },
        {
          "name": "Admin Printable Invoice Data",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ADMIN_ACCESS_TOKEN}}" }
            ],
            "url": "{{BASE_URL}}/admin/orders/{{ORDER_ID}}/invoice"
          }
        }
      ]
    }
  ]
}
