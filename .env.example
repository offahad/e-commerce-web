# Liton Brothers - Production Environment Configuration

NODE_ENV=development
PORT=4000
APP_NAME="Liton Brothers"
BASE_URL="http://localhost:4000"

# Security & Tokens
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
JWT_REFRESH_SECRET="replace-with-a-secure-random-refresh-secret-key-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Default Seed Super Admin (Changed in production)
ADMIN_DEFAULT_PHONE="01700000000"
ADMIN_DEFAULT_PASSWORD="ChangeMe@123456"

# Database Connection
# If unset, the service initializes an embedded in-memory PostgreSQL engine
DATABASE_URL=postgres://user:password@localhost:5432/liton_brothers

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Storage Provider (local or s3)
STORAGE_PROVIDER=local
STORAGE_BUCKET=liton-brothers-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payment Gateways
PAYMENT_GATEWAY=cod
PAYMENT_API_KEY=
PAYMENT_SECRET=

# SMS & Notifications
SMS_PROVIDER=mock
SMS_API_KEY=

# Email SMTP
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
